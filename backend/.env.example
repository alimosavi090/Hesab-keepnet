APP_ENV=development
APP_PORT=8080
DATABASE_PATH=./data/accounting.db
CORS_ORIGIN=http://localhost:3000
# یک رشته تصادفی حداقل ۱۶ کاراکتر؛ تولید با: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_RANDOM_32_CHARS
COOKIE_SECURE=false

# Optional (development only): seed an initial admin user.
# Leave both empty to skip user seeding.
ADMIN_USERNAME=
ADMIN_PASSWORD=
